namespace Analyser is
    use System.Exception
    use System.Diagnostics.Process
    use System.Diagnostics.ProcessStartInfo
    use System.Text.StringBuilder
    use System.Text.UTF8Encoding
    use System.Text.Json.JsonSerializer
    use System.Text.Json.JsonSerializerOptions

    use Collections.LIST
    use Collections.MAP

    use IO.Directory
    use IO.File
    use IO.Path
    use IO.Std

    use Ghul.Disposable

    use Analysis.Protocol.EDIT_FILE
    use Analysis.Protocol.Request
    use Analysis.Protocol.Response

    class ASSEMBLIES_FILE is
        assemblies: LIST[string] public

        // JsonSerializer.deserialize bypasses this and assigns the field by
        // reflection.
        @suppress("field-definite-assignment")
        init() is si
    si

    // Shape of .ghul-options.json, written by the ghul.runtime 14.1.0+
    // GenerateGhulOptionsJson target: the fully-resolved compiler flags the
    // build itself would pass, as one whitespace-separated (quote-aware)
    // string - conditions applied, properties evaluated. See degory/ghul#2090.
    class GHUL_OPTIONS_FILE is
        options: string public

        // Optional analyser compiler override, emitted by the
        // GenerateGhulOptionsJson target once ghul.runtime carries it.
        // Absent on every project today; the hand-parsed property read in
        // resolve_analyser_compiler_dll covers the meantime.
        analyser_compiler: string? public

        // JsonSerializer.deserialize bypasses this and assigns the field by
        // reflection.
        @suppress("field-definite-assignment")
        init() is si
    si

    // A long-lived `dotnet ghul-compiler --analyse` session over one ghūl
    // project. Spawns the project's own pinned compiler tool in the project
    // directory, seeds it with the project's assembly references (from
    // `.assemblies.json`, regenerated on every spawn) and source contents
    // (via edit requests), and re-sends any file whose on-disk timestamp
    // moved before answering each query - so results always reflect what is
    // on disk, not what was there at startup.
    class ANALYSER_SESSION: Disposable is
        _project_directory: string
        _options: JsonSerializerOptions
        _process: Process?
        _temp_directory: string?
        _compiler_version: string?

        // The DLL this project opts into for analysis via the
        // GhulAnalyserCompiler property, resolved once per spawn. Null when
        // unset: the spawn then uses the project's pinned ghul.compiler tool
        // as before.
        _analyser_compiler_dll: string?

        // Identity of everything that picked the answering compiler, so a
        // warm session can be recycled when it changes underneath us.
        _compiler_fingerprint: string?

        // Throttles the drift check above to at most one run per interval
        // on a warm session: every query path funnels through
        // ensure_spawned, and a hover burst must not pay a manifest walk
        // per request.
        _next_fingerprint_check: System.DateTime

        _mtimes: MAP[string, System.DateTime]
        _stderr_capture: StringBuilder
        _last_hints_for: LIST[string]

        // Bumped on every request; used to trigger periodic heap-check
        // pings that let the analyser's watchdog recycle the process
        // before it grows too large.
        _query_count: long

        // Monotonic use-order counter, updated by the pool on every
        // get_session so it can evict the least-recently-used entry when
        // it reaches its size cap.
        last_used_order: long public

        // How often (in requests) to send an unsolicited heap_check ping.
        // The compiler's own watchdog also samples the heap after every
        // Nth compile as a fallback, so this doesn't have to be tight -
        // it's belt-and-braces so a long-lived session that mostly serves
        // hovers doesn't grow unbounded between the fallback samples.
        HEAP_CHECK_EVERY: int static => 20

        FINGERPRINT_CHECK_INTERVAL_SECONDS: double static => 1.0D

        init(project_directory: string) is
            _project_directory = Path.get_full_path(project_directory)
            _options = JsonSerializerOptions()

            // Union constructor args surface as public CLR fields, which
            // System.Text.Json skips by default.
            _options.include_fields = true

            _temp_directory = null
            _mtimes = MAP[string, System.DateTime]()
            _stderr_capture = StringBuilder()
            _last_hints_for = LIST[string]()
            _query_count = 0L
            last_used_order = 0L
            _next_fingerprint_check = System.DateTime.min_value
        si

        // OS process id of the running analyser, or null if it hasn't
        // been spawned (or has exited). Handy for the sessions tool.
        process_id: int? is
            let p = _process

            if !p? \/ p.has_exited then
                return null
            fi

            return p.id
        si

        // The number of source files known to this session (empty on a
        // fresh session, populated after the first sync_sources).
        known_source_count: int => _mtimes.count

        // The analyser's current working set in bytes, or null when no
        // analyser process is running.
        working_set: long? is
            let p = _process

            if !p? \/ p.has_exited then
                return null
            fi

            return p.working_set64
        si

        // Compiler version the analyser advertised on its LISTEN frame,
        // or null before the first spawn.
        compiler_version: string? => _compiler_version

        open_paths_equal(a: LIST[string], b: LIST[string]) -> bool static is
            if a.count != b.count then
                return false
            fi

            for i in 0..(a.count - 1) do
                if a[i] !~ b[i] then
                    return false
                fi
            od

            return true
        si

        project_directory: string => _project_directory

        is_running: bool => _process? /\ !_process.has_exited

        // Relative paths of every ghūl source the .ghulproj glob (or globs)
        // would include. Falls back to a whole-tree walk if the .ghulproj
        // can't be read - old repos, unusual layouts. Deduped so a source
        // matched by two globs is only sent once.
        // The source globs the build published for this project, or null when
        // it did not - a ghul.runtime older than 14.4.0, or a project whose
        // declarations are all conditional. One pattern per line, as written
        // rather than as expanded.
        published_source_globs() -> LIST[string]? is
            let path = Path.combine(temp_directory(), "source-globs.txt")

            if !File.exists(path) then
                return null
            fi

            let globs = LIST[string]()

            for line in File.read_all_lines(path) do
                let trimmed = line.trim()

                if trimmed.length > 0 then
                    globs.add(trimmed)
                fi
            od

            if globs.count == 0 then
                return null
            fi

            return globs
        si

        find_sources() -> LIST[string] is
            // The build's answer first: it sees a shared Directory.Build.props
            // and knows which patterns it actually compiles, where the project
            // file parse below sees neither.
            let globs = published_source_globs() ?? load_ghulproj_source_globs()

            let seen = Collections.SET[string]()
            let result = LIST[string]()

            if globs? /\ globs.count > 0 then
                for glob in globs do
                    for absolute in expand_glob(glob) do
                        let relative = Path.get_relative_path(_project_directory, absolute)

                        if !seen.contains(relative) then
                            seen.add(relative)
                            result.add(relative)
                        fi
                    od
                od

                return result
            fi

            // Fallback for a project directory without a readable .ghulproj:
            // walk the tree recursively, skipping obvious build outputs.
            let absolute = LIST[string]()

            add_sources(_project_directory, absolute)

            for path in absolute do
                let relative = Path.get_relative_path(_project_directory, path)

                if !seen.contains(relative) then
                    seen.add(relative)
                    result.add(relative)
                fi
            od

            return result
        si

        // Parse the single .ghulproj under the project directory and return
        // every `<GhulSources Include="pattern" />` pattern. Null (rather
        // than an empty list) signals "no readable project file, use the
        // fallback walk" so a workspace with genuinely no sources doesn't
        // accidentally trigger a directory sweep.
        load_ghulproj_source_globs() -> LIST[string]? is
            let projects = Directory.get_files(_project_directory, "*.ghulproj")

            if projects.count != 1 then
                return null
            fi

            try
                let document = System.Xml.Linq.XDocument.load(projects[0])
                let root = document.root

                if !root? then
                    return null
                fi

                let result = LIST[string]()

                for element in root.descendants(System.Xml.Linq.XName.get("GhulSources")) do
                    let include_attr = element.attribute(System.Xml.Linq.XName.get("Include"))

                    if include_attr? then
                        let value = include_attr.value

                        if value.length > 0 then
                            result.add(value)
                        fi
                    fi
                od

                return result
            catch ex: Exception
                return null
            yrt
        si

        // Resolve the compiler options the command-line build passes but the
        // analyser otherwise wouldn't (e.g. `--underscore-access legacy`,
        // `--warn-as-hint <slug>`). Prefers .ghul-options.json, regenerated on
        // every spawn the same way .assemblies.json is: that file is written
        // by MSBuild itself, post-Condition and post-property-evaluation, so
        // it sees things the hand-rolled XML parse below cannot - a Condition
        // on the enclosing ItemGroup, GhulOptions in property form, a $(...)
        // reference. Falls back to load_ghulproj_compiler_options when the
        // file never appears, which is the normal case for a project still
        // pinned to a ghul.runtime older than 14.1.0 (no
        // GenerateGhulOptionsJson target to run).
        resolve_compiler_options() -> LIST[string] is
            let options_json_path = Path.combine(_project_directory, ".ghul-options.json")

            generate_ghul_options_json()

            if File.exists(options_json_path) then
                try
                    let options_file = JsonSerializer.deserialize[GHUL_OPTIONS_FILE](File.read_all_text(options_json_path), _options)

                    assert options_file? /\ options_file.options? else
                        Exception("could not read the options field from {options_json_path}")

                    return _tokenize_quoted(options_file.options)
                catch ex: Exception
                    Std.error.write_line(
                        "ghul-mcp: could not read {options_json_path} ({ex.message}); "
                        "falling back to hand-parsed .ghulproj options"
                    )
                yrt
            fi

            return load_ghulproj_compiler_options()
        si

        // The compiler DLL this project opts into for analysis via an
        // optional GhulAnalyserCompiler MSBuild property, or null to use the
        // project's pinned ghul.compiler tool as before. Read from
        // .ghul-options.json when the project's ghul.runtime emits it there
        // (evaluated, conditions applied); otherwise hand-read as the first
        // unconditional property element in the project's .ghulproj, then in
        // Directory.Build.props files walking up from the project directory,
        // nearest file winning and the walk stopping at the filesystem root.
        // The hand read cannot evaluate imports or conditions - it skips
        // Condition-guarded elements, which is also how a props file scopes
        // itself away for chosen projects - but it substitutes
        // $(MSBuildThisFileDirectory) and $(MSBuildProjectDirectory), the
        // two tokens a plain path-valued property needs.
        resolve_analyser_compiler_dll() -> string? is
            let options_json_path = Path.combine(_project_directory, ".ghul-options.json")

            if File.exists(options_json_path) then
                try
                    if let options_file: GHUL_OPTIONS_FILE = JsonSerializer.deserialize[GHUL_OPTIONS_FILE](File.read_all_text(options_json_path), _options) then
                        if let value: string = options_file.analyser_compiler then
                            if value.trim().length > 0 then
                                return Path.get_full_path(Path.combine(_project_directory, value))
                            fi
                        fi
                    fi
                catch ex: Exception
                yrt
            fi

            let projects = Directory.get_files(_project_directory, "*.ghulproj")

            if projects.count == 1 then
                if let value = _read_analyser_compiler_property(projects[0], _project_directory) then
                    return value
                fi
            fi

            // MSBuild probes the project directory itself for
            // Directory.Build.props before its ancestors.
            if let value = _read_analyser_compiler_property(Path.combine(_project_directory, "Directory.Build.props"), _project_directory) then
                return value
            fi

            let dir mut = _project_directory

            while true do
                let parent = Path.get_full_path(Path.combine(dir, ".."))

                if parent =~ dir then
                    return null
                fi

                dir = parent

                if let value = _read_analyser_compiler_property(Path.combine(dir, "Directory.Build.props"), dir) then
                    return value
                fi
            od

            return null
        si

        // One file's unconditional GhulAnalyserCompiler property, resolved
        // against base_directory, or null when the file has none (or cannot
        // be read).
        _read_analyser_compiler_property(path: string, base_directory: string) -> string? is
            if !File.exists(path) then
                return null
            fi

            try
                let document = System.Xml.Linq.XDocument.load(path)
                let root = document.root

                if !root? then
                    return null
                fi

                // Property evaluation is sequential: a later unconditional
                // assignment overwrites an earlier one, so the LAST
                // unconditioned element in document order is the value the
                // build would honour - not the first.
                let found: string? mut = null

                for element in root.descendants(System.Xml.Linq.XName.get("GhulAnalyserCompiler")) do
                    let condition_attr = element.attribute(System.Xml.Linq.XName.get("Condition"))

                    if !condition_attr? then
                        // Substitute against a slash-terminated base so a
                        // value like $(MSBuildThisFileDirectory)../x.dll
                        // cannot glue the ".." onto the last segment.
                        let base_slashed =
                            if base_directory.ends_with("/") then
                                base_directory
                            else
                                "{base_directory}/"
                            fi

                        let project_slashed =
                            if _project_directory.ends_with("/") then
                                _project_directory
                            else
                                "{_project_directory}/"
                            fi

                        let value = element.value.replace("$(MSBuildThisFileDirectory)", base_slashed).replace("$(MSBuildProjectDirectory)", project_slashed)

                        if value.trim().length > 0 then
                            found = value
                        fi
                    fi
                od

                if let value: string = found then
                    return Path.get_full_path(value)
                fi
            catch ex: Exception
            yrt

            return null
        si

        // Identity of everything that decides which compiler binary answers:
        // the resolved override's path, write time and length when one is
        // configured, otherwise the bytes of the dotnet local-tool manifest
        // the spawn would resolve through, else a constant. A warm session
        // whose current fingerprint differs from its spawn-time one gets
        // recycled rather than kept answering on a moved compiler.
        compute_compiler_fingerprint() -> string is
            // ghul names a manifest project's compiler from the manifest and
            // the lockfile, so an edit to either can change it. start() never
            // uses the override for one, so neither does this.
            if MANIFEST_PROJECT.is_manifest_project(_project_directory) then
                return "ghul-project {_read_or_none(MANIFEST_PROJECT.MANIFEST)} {_read_or_none(MANIFEST_PROJECT.LOCKFILE)}"
            fi

            // Re-resolve rather than read the field cached at spawn time:
            // the drift check exists precisely to notice when the property
            // now points somewhere else, and a cached path would make a
            // re-pointed property invisible.
            if let path: string = resolve_analyser_compiler_dll() then
                try
                    if !File.exists(path) then
                        return "dll-missing {path}"
                    fi

                    let stamp = File.get_last_write_time_utc(path)

                    return "dll {path} {stamp.ticks}"
                catch ex: Exception
                    return "dll-unreadable {path}"
                yrt
            fi

            let dir mut = _project_directory

            while true do
                let candidate = Path.combine(dir, ".config/dotnet-tools.json")

                if File.exists(candidate) then
                    try
                        return "manifest {candidate} {File.read_all_text(candidate)}"
                    catch ex: Exception
                        return "manifest-unreadable {candidate}"
                    yrt
                fi

                let parent = Path.get_full_path(Path.combine(dir, ".."))

                if parent =~ dir then
                    return "none"
                fi

                dir = parent
            od

            return "none"
        si

        _read_or_none(name: string) -> string is
            try
                return File.read_all_text(Path.combine(_project_directory, name))
            catch ex: Exception
                return "none"
            yrt
        si

        // Ask MSBuild to write the project's fully-resolved compiler flags to
        // .ghul-options.json; the target ships in ghul.runtime 14.1.0+'s
        // build targets (degory/ghul#2090). Best-effort and silent on
        // failure: a project still pinned to an older ghul.runtime has no
        // such target, and that is the normal case rather than a problem to
        // report - resolve_compiler_options falls back to the hand-rolled
        // parse when the file never appears.
        generate_ghul_options_json() is
            let start_info = ProcessStartInfo()

            start_info.file_name = "dotnet"
            start_info.arguments = "build -verbosity:quiet -t:GenerateGhulOptionsJson"
            start_info.working_directory = _project_directory

            start_info.use_shell_execute = false
            start_info.redirect_standard_output = true
            start_info.redirect_standard_error = true

            let process = Process.start(start_info)

            if !process? then
                return
            fi

            process.standard_output.read_to_end()
            process.standard_error.read_to_end()

            process.wait_for_exit(120000)
        si

        // Split a flag string on runs of whitespace, treating a
        // double-quoted run as part of the surrounding token with the quote
        // characters themselves dropped - so `--suppress "a,b"` tokenizes as
        // (`--suppress`, `a,b`) rather than three pieces. The build always
        // emits balanced double quotes around any value that could contain
        // whitespace, so no backslash-escaping support is needed here.
        _tokenize_quoted(text: string) -> LIST[string] is
            let result = LIST[string]()
            let current = StringBuilder()
            let in_quotes mut = false
            let has_token mut = false

            for c in text do
                if c == '"' then
                    in_quotes = !in_quotes
                    has_token = true
                elif !in_quotes /\ (c == ' ' \/ c == '\t' \/ c == '\n' \/ c == '\r') then
                    if has_token then
                        result.add(current.to_string())
                        current.clear()
                        has_token = false
                    fi
                else
                    current.append(c)
                    has_token = true
                fi
            od

            if has_token then
                result.add(current.to_string())
            fi

            return result
        si

        // Parse the single .ghulproj and return the compiler options the
        // command-line build passes but the analyser otherwise wouldn't:
        // the flags after `ghul-compiler` in `<GhulCompiler>` (e.g.
        // `--underscore-access legacy`) plus every `<GhulOptions Include="…" />`
        // that carries no `Condition` (e.g. `--warn-as-hint <slug>`).
        // Condition-guarded options are skipped so the analyser tracks a local
        // build, not a CI build. Empty on any read failure. Fallback for a
        // project referencing a ghul.runtime older than 14.1.0 - see
        // resolve_compiler_options.
        load_ghulproj_compiler_options() -> LIST[string] is
            let result = LIST[string]()

            let projects = Directory.get_files(_project_directory, "*.ghulproj")

            if projects.count != 1 then
                return result
            fi

            try
                let document = System.Xml.Linq.XDocument.load(projects[0])
                let root = document.root

                if !root? then
                    return result
                fi

                for element in root.descendants(System.Xml.Linq.XName.get("GhulCompiler")) do
                    let seen_program mut = false

                    for token in _tokenize(element.value) do
                        if seen_program then
                            result.add(token)
                        elif token.ends_with("ghul-compiler") then
                            seen_program = true
                        fi
                    od
                od

                for element in root.descendants(System.Xml.Linq.XName.get("GhulOptions")) do
                    let condition_attr = element.attribute(System.Xml.Linq.XName.get("Condition"))

                    if !condition_attr? then
                        let include_attr = element.attribute(System.Xml.Linq.XName.get("Include"))

                        if include_attr? then
                            for token in _tokenize(include_attr.value) do
                                result.add(token)
                            od
                        fi
                    fi
                od

                return result
            catch ex: Exception
                return result
            yrt
        si

        // Split a command fragment on runs of whitespace, dropping empties.
        _tokenize(text: string) -> LIST[string] is
            let result = LIST[string]()

            let current = StringBuilder()

            for c in text do
                if c == ' ' \/ c == '\t' \/ c == '\n' \/ c == '\r' then
                    if current.length > 0 then
                        result.add(current.to_string())
                        current.clear()
                    fi
                else
                    current.append(c)
                fi
            od

            if current.length > 0 then
                result.add(current.to_string())
            fi

            return result
        si

        // Expand one MSBuild-style glob against the project directory. The
        // common cases the compiler and its sibling projects actually use
        // are `<prefix>/**/*.ghul`, `**/*.ghul`, `<prefix>/*.ghul`, and a
        // literal path; anything more exotic falls back to a top-level
        // enumeration of the pattern's directory.
        expand_glob(pattern: string) -> LIST[string] is
            let normalized = pattern.replace('\\', '/')
            let matches = LIST[string]()

            let recursive_marker = "/**/"
            let recursive_at = normalized.index_of(recursive_marker)

            if recursive_at >= 0 then
                let base_relative = normalized.substring(0, recursive_at)
                let file_pattern = normalized.substring(recursive_at + recursive_marker.length)

                let base_directory =
                    if base_relative.length > 0 then
                        Path.combine(_project_directory, base_relative)
                    else
                        _project_directory
                    fi

                if Directory.exists(base_directory) then
                    add_files_recursive(base_directory, file_pattern, matches)
                fi

                return matches
            fi

            if normalized.starts_with("**/") then
                let file_pattern = normalized.substring(3)

                add_files_recursive(_project_directory, file_pattern, matches)

                return matches
            fi

            let last_slash = normalized.last_index_of('/')

            if last_slash >= 0 then
                let base_relative = normalized.substring(0, last_slash)
                let file_pattern = normalized.substring(last_slash + 1)
                let base_directory = Path.combine(_project_directory, base_relative)

                if !file_pattern.contains("*") /\ !file_pattern.contains("?") then
                    let literal = Path.combine(base_directory, file_pattern)

                    if File.exists(literal) then
                        matches.add(literal)
                    fi

                    return matches
                fi

                if Directory.exists(base_directory) then
                    for f in Directory.get_files(base_directory, file_pattern) do
                        matches.add(f)
                    od
                fi

                return matches
            fi

            let bare = Path.combine(_project_directory, normalized)

            if !normalized.contains("*") /\ !normalized.contains("?") then
                if File.exists(bare) then
                    matches.add(bare)
                fi

                return matches
            fi

            for f in Directory.get_files(_project_directory, normalized) do
                matches.add(f)
            od

            return matches
        si

        add_files_recursive(directory: string, file_pattern: string, result: LIST[string]) is
            let name = Path.get_file_name(directory)

            if name =~ "bin" \/ name =~ "obj" \/ name =~ "publish" \/ name =~ ".git" then
                return
            fi

            for f in Directory.get_files(directory, file_pattern) do
                result.add(f)
            od

            for d in Directory.get_directories(directory) do
                add_files_recursive(d, file_pattern, result)
            od
        si

        add_sources(directory: string, result: LIST[string]) is
            let name = Path.get_file_name(directory)

            if name =~ "bin" \/ name =~ "obj" \/ name =~ "publish" \/ name =~ ".git" then
                return
            fi

            for f in Directory.get_files(directory, "*.ghul") do
                result.add(f)
            od

            for d in Directory.get_directories(directory) do
                add_sources(d, result)
            od
        si

        // A directory of this session's own, holding the files it and the
        // build generate on the way to a compiler command line. They used to
        // be written into the project, where nothing owned them: two sessions
        // on one project overwrote each other's, and anything outliving a
        // crash stayed in the checkout until someone noticed it. Here a crash
        // leaves them where the system reclaims them.
        //
        // Created on first use, so a project that never spawns an analyser
        // never makes one.
        temp_directory() -> string is
            if let directory: string = _temp_directory then
                return directory
            fi

            let directory = Path.combine(Path.get_temp_path(), "ghul-mcp-{System.Guid.new_guid()}")

            Directory.create_directory(directory)

            _temp_directory = directory

            return directory
        si

        // Ask MSBuild to resolve the project's compiler options and reference
        // assemblies into a response file. The target ships in ghul.runtime
        // 14.3.0+'s build targets (degory/ghul#2132) and supersedes the two
        // JSON targets, which published the same two halves in a format
        // nothing else speaks.
        //
        // Whether the file is there afterwards is what the caller reads, so
        // this reports nothing that would be noise: a project pinned to an
        // older ghul.runtime has no such target, MSBuild says so as MSB4057,
        // and start() falls back to the JSON targets that runtime does have.
        // Any other failure is a build that went wrong on a project that does
        // have the target, and the fallback's own message would misattribute
        // it to a missing or unrestored project - so it is reported here,
        // where what actually happened is still in hand.
        generate_response_file(path: string, source_globs_path: string) is
            let start_info = ProcessStartInfo()

            start_info.file_name = "dotnet"
            start_info.arguments = "build -verbosity:quiet -t:GenerateGhulResponseFile -p:GhulResponseFile=\"{path}\" -p:GhulSourceGlobsFile=\"{source_globs_path}\""
            start_info.working_directory = _project_directory

            start_info.use_shell_execute = false
            start_info.redirect_standard_output = true
            start_info.redirect_standard_error = true

            let process = Process.start(start_info)

            if !process? then
                return
            fi

            let out = process.standard_output.read_to_end()
            let err = process.standard_error.read_to_end()

            if !process.wait_for_exit(120000) then
                Std.error.write_line("ghul-mcp: timed out resolving {_project_directory} into a response file")
                return
            fi

            if process.exit_code == 0 \/ out.contains("MSB4057") \/ err.contains("MSB4057") then
                return
            fi

            Std.error.write_line(
                "ghul-mcp: could not resolve {_project_directory} into a response file "
                "(dotnet build -t:GenerateGhulResponseFile exited {process.exit_code}); "
                "falling back to .assemblies.json"
            )

            Std.error.write_line(out)
            Std.error.write_line(err)
        si

        // Has the ghul tool write a manifest project's response file and
        // source globs, for the first target the manifest lists when it
        // lists several. Throws with the reason when it cannot: unlike a
        // .ghulproj there is no older format to fall back to.
        generate_manifest_response_file(path: string, source_globs_path: string) is
            if File.exists(path) then
                File.delete(path)
            fi

            let arguments = StringBuilder()

            arguments.append("project response-file --output \"{path}\" --source-globs \"{source_globs_path}\"")

            if let target: string = MANIFEST_PROJECT.target_to_analyse(_project_directory) then
                arguments.append(" --target {target}")
            fi

            MANIFEST_PROJECT.run_ghul(_project_directory, arguments.to_string())

            if !File.exists(path) then
                throw Exception("ghul wrote no response file for {_project_directory}")
            fi
        si

        // The command that runs the compiler a manifest project builds with,
        // as ghul names it. Asked at every spawn rather than kept: with no
        // compiler in the manifest it is the newest installed.
        manifest_compiler() -> LIST[string] is
            let output = MANIFEST_PROJECT.run_ghul(_project_directory, "project compiler")

            for line in output.split(['\n']) do
                let trimmed = line.trim()

                if trimmed.length > 0 then
                    return _tokenize_quoted(trimmed)
                fi
            od

            throw Exception("ghul named no compiler for {_project_directory}")
        si

        // Read the build's response file into the analyser's argument list.
        // Each line is one flag with its argument, so a line is tokenized
        // whole and never read across lines.
        //
        // The compiler follows a nested @<path> itself, so this could have
        // been one argument naming the file. It is read instead so that a
        // reference the build could not produce can be withheld: the analyser
        // reads each -a eagerly and stops at the first one that is not there.
        read_response_file(path: string, arguments: LIST[string]) is
            for line in File.read_all_lines(path) do
                let trimmed = line.trim()

                if trimmed.length == 0 then
                    continue
                fi

                add_arguments(_tokenize_quoted(trimmed), arguments)
            od
        si

        // Add one flag and its argument, unless it is a -a naming an assembly
        // that is not there. Passing the compiler a reference path that does
        // not resolve is the client's mistake and it reports it as one, so a
        // project whose references have not all been built would take the
        // analyser down with it. Withholding leaves analysis incomplete until
        // they appear, which is what an editor over a half-built tree needs.
        add_arguments(tokens: LIST[string], arguments: LIST[string]) is
            if tokens.count > 1 /\ tokens[0] =~ "-a" /\ !File.exists(tokens[1]) then
                Std.error.write_line(
                    "ghul-mcp: referenced assembly {tokens[1]} is not present yet, "
                    "analysis will be incomplete until it is built"
                )

                return
            fi

            for token in tokens do
                arguments.add(token)
            od
        si

        // The reference paths and options as the two JSON targets published
        // them, for a project pinned to a ghul.runtime older than 14.3.0.
        read_json_configuration(arguments: LIST[string]) is
            let assemblies_json_path = Path.combine(_project_directory, ".assemblies.json")

            // Unconditionally, not just when the file is absent: it is a
            // build artifact of whatever the project's references resolved
            // to the last time someone built, and nothing keeps it in step
            // with a package bump afterwards. A stale one is worse than a
            // missing one, because it spawns an analyser that looks healthy
            // and answers wrongly - referencing a runtime older than the
            // compiler needs leaves the intrinsics unregistered, so basic
            // operators fail to resolve, the failure is swallowed per file,
            // and every declaration past the first failure in a file
            // reports its types as unresolved.
            let regenerated = generate_assemblies_json()

            if !File.exists(assemblies_json_path) then
                throw Exception("could not produce .assemblies.json in {_project_directory} - is this a ghūl project with its dotnet tools restored?")
            fi

            // Regeneration failed but a file is there, so it predates this
            // spawn and may describe references the project no longer uses.
            // Proceeding beats refusing to answer at all - a project whose
            // reference resolution is broken is one someone plausibly wants
            // to inspect - but generate_assemblies_json has already said so
            // on stderr rather than letting it pass unremarked.
            if !regenerated then
                Std.error.write_line("ghul-mcp: continuing with the existing .assemblies.json in {_project_directory}")
            fi

            let assemblies_file = JsonSerializer.deserialize[ASSEMBLIES_FILE](File.read_all_text(assemblies_json_path), _options)

            // JsonSerializer.deserialize bypasses ASSEMBLIES_FILE's init(),
            // assigning fields by reflection - so a missing or null
            // "assemblies" key in the JSON leaves this non-optional
            // LIST[string] null at runtime despite its static type. The
            // presence test is deliberate, not redundant, hence the assert.
            assert assemblies_file? /\ assemblies_file.assemblies? else
                Exception("could not read an assemblies list from {assemblies_json_path}")

            for assembly in assemblies_file.assemblies do
                let assembly_tokens = LIST[string]()

                assembly_tokens.add("-a")
                assembly_tokens.add(assembly)

                add_arguments(assembly_tokens, arguments)
            od

            // Match the command-line build: forward the ghulproj's own
            // compiler options. Without `--underscore-access legacy` the
            // compiler's legacy cross-class `_`-member accesses report as
            // inaccessible; without `--warn-as-hint <slug>` demoted warnings
            // come back as full warnings.
            for option in resolve_compiler_options() do
                arguments.add(option)
            od
        si

        start() is
            let arguments = LIST[string]()

            let project_response_file = Path.combine(temp_directory(), "project.rsp")
            let source_globs_path = Path.combine(temp_directory(), "source-globs.txt")

            // A ghul-project.json project is resolved by the ghul tool, which
            // writes the same two files a .ghulproj build does and names the
            // compiler; none of the .NET build steps apply to it.
            let is_manifest_project = MANIFEST_PROJECT.is_manifest_project(_project_directory)

            if is_manifest_project then
                generate_manifest_response_file(project_response_file, source_globs_path)
                read_response_file(project_response_file, arguments)
            else
                generate_response_file(project_response_file, source_globs_path)

                if File.exists(project_response_file) then
                    read_response_file(project_response_file, arguments)
                else
                    read_json_configuration(arguments)
                fi
            fi

            arguments.add("-A")

            let response_file = Path.combine(temp_directory(), "analysis.rsp")
            let line = StringBuilder()

            for argument in arguments do
                line.append("\"{argument}\" ")
            od

            File.write_all_text(response_file, line.to_string())

            let start_info = ProcessStartInfo()

            _analyser_compiler_dll = resolve_analyser_compiler_dll()

            let program mut = "ghul-compiler"

            if let dll: string = _analyser_compiler_dll then
                if File.exists(dll) then
                    program = "\"{dll}\""
                else
                    // The tree build the property points at is absent (a
                    // worktree between publishes, say). The pinned tool is
                    // still better than a dead session; the version stamp on
                    // replies makes the substitution visible.
                    Std.error.write_line("ghul-mcp: analyser compiler override not found ({dll}); using the pinned ghul.compiler tool")
                fi
            fi

            if is_manifest_project then
                let compiler = manifest_compiler()

                start_info.file_name = compiler[0]

                let rest = StringBuilder()

                for index in 1..compiler.count do
                    rest.append("\"{compiler[index]}\" ")
                od

                start_info.arguments = "{rest}@\"{response_file}\""
            else
                start_info.file_name = "dotnet"
                start_info.arguments = "{program} @\"{response_file}\""
            fi

            start_info.working_directory = _project_directory

            start_info.use_shell_execute = false
            start_info.redirect_standard_input = true
            start_info.redirect_standard_output = true
            start_info.redirect_standard_error = true

            start_info.standard_input_encoding = UTF8Encoding()
            start_info.standard_output_encoding = UTF8Encoding()
            start_info.standard_error_encoding = UTF8Encoding()

            let started = Process.start(start_info)

            if !started? then
                throw Exception("failed to start dotnet ghul-compiler in {_project_directory}")
            fi

            _process = started

            _compiler_fingerprint = compute_compiler_fingerprint()

            // Drain stderr in the background so a chatty analyser doesn't
            // fill its stderr pipe and block.
            Tasks.TASK.run(
                () is
                    try
                        do
                            let stderr_line = started.standard_error.read_line()

                            if !stderr_line? then
                                break
                            fi

                            _stderr_capture.append(stderr_line)
                            _stderr_capture.append('\n')
                        od
                    catch ex: Exception
                    yrt
                si
            )

            let first = read_response()

            if let listen: Response.LISTEN = first then
                _reject_if_compiler_too_old(listen.compiler_version)

                _compiler_version = listen.compiler_version
            else
                throw Exception("expected listen as the analyser's first response - is the ghul.compiler tool restored in {_project_directory}?\nstderr so far:\n{_stderr_capture}")
            fi

            _mtimes.clear()
        si

        // Minimum ghul.compiler version ghul-mcp requires. Raise whenever
        // ghul-mcp adopts a new protocol feature - the diagnostic the
        // client raises here is a lot clearer than the wire-level hang
        // that a version mismatch otherwise causes.
        //
        // The floor is the pinned ghul.compiler in .config/dotnet-tools.json:
        // that is the only client/analyser pair the smoke test exercises, so
        // it is the oldest analyser this build is verified against. When a
        // pin bump moves the compiler or ghul.analysis.protocol, move this
        // with it. A floor older than the pins claims compatibility nobody
        // has tested. (Historically 20.3.0, the first version answering the
        // INLAY_HINTS query the `inlays` tool depends on, ghul#1642; any
        // analyser predating compiler_version on the LISTEN frame, ghul#1634
        // / 19.13.0, is "too old to negotiate" and refused.)
        MIN_COMPILER_VERSION: string static => "59.1.1"

        _reject_if_compiler_too_old(reported: string?) is
            if !reported? \/ reported.length == 0 then
                throw Exception(
                    "analyser at {_project_directory} did not advertise a compiler version on its LISTEN frame. "
                    "That means it is older than 19.13.0 - and ghul-mcp needs at least {MIN_COMPILER_VERSION}. "
                    "Bump the pin in {_project_directory}/.config/dotnet-tools.json with "
                    "`dotnet tool update --local ghul.compiler`."
                )
            fi

            // A 0.0.0-* version is a local dev pack (`dotnet pack
            // -p:Version=0.0.0-local-<slug>.1` installed into the project's
            // manifest), built from current source, so its protocol is at
            // least as new as any published floor and the numeric triple
            // says nothing. Testing an unpublished compiler is exactly when
            // diagnostics are wanted, so exempt rather than refuse it.
            if reported.starts_with("0.0.0-") then
                return
            fi

            if compare_versions(reported, MIN_COMPILER_VERSION) < 0 then
                throw Exception(
                    "analyser at {_project_directory} is ghul.compiler {reported}, "
                    "but ghul-mcp requires at least {MIN_COMPILER_VERSION}. "
                    "Bump the pin in {_project_directory}/.config/dotnet-tools.json with "
                    "`dotnet tool update --local ghul.compiler`."
                )
            fi
        si

        // Semver-ish comparison: split on `.` and `-`, compare the leading
        // major.minor.patch triple numerically, ignore any prerelease
        // suffix. Returns negative if `left` < `right`, zero if equal,
        // positive if greater. Good enough for a min-version check where
        // we don't need to distinguish `19.13.0-alpha.1` from `19.13.0`.
        compare_versions(left: string, right: string) -> int static is
            let left_parts = _extract_numeric_triple(left)
            let right_parts = _extract_numeric_triple(right)

            for i in 0..3 do
                if left_parts[i] != right_parts[i] then
                    return left_parts[i] - right_parts[i]
                fi
            od

            return 0
        si

        _extract_numeric_triple(version: string) -> LIST[int] static is
            let result = LIST([0, 0, 0])

            let index mut = 0
            let current mut = 0
            let has_digits mut = false

            for c in version do
                if index >= 3 then
                    break
                fi

                if c >= '0' /\ c <= '9' then
                    current = current * 10 + (cast int(c) - cast int('0'))
                    has_digits = true
                elif c == '.' then
                    if has_digits then
                        result[index] = current
                        index = index + 1
                        current = 0
                        has_digits = false
                    fi
                else
                    break
                fi
            od

            if has_digits /\ index < 3 then
                result[index] = current
            fi

            return result
        si

        // Ask MSBuild to write the project's reference-assembly list; the
        // target ships in the ghūl runtime's build targets. Returns whether
        // it succeeded - the caller needs to know, because a failure here
        // leaves whatever stale file was already on disk, which is exactly
        // the state that produces confidently wrong analysis.
        generate_assemblies_json() -> bool is
            let start_info = ProcessStartInfo()

            start_info.file_name = "dotnet"
            start_info.arguments = "build -verbosity:quiet -t:GenerateAssembliesJson"
            start_info.working_directory = _project_directory

            start_info.use_shell_execute = false
            start_info.redirect_standard_output = true
            start_info.redirect_standard_error = true

            let process = Process.start(start_info)

            if !process? then
                return false
            fi

            process.standard_output.read_to_end()
            let errors = process.standard_error.read_to_end()

            if !process.wait_for_exit(120000) then
                Std.error.write_line("ghul-mcp: timed out regenerating .assemblies.json in {_project_directory}")
                return false
            fi

            if process.exit_code != 0 then
                Std.error.write_line(
                    "ghul-mcp: could not regenerate .assemblies.json in {_project_directory} "
                    "(dotnet build -t:GenerateAssembliesJson exited {process.exit_code}); "
                    "analysis will use whatever reference list is already on disk\n{errors}"
                )
                return false
            fi

            return true
        si

        // Ensure the analyser subprocess is up, spawning a fresh one if not.
        // Split from source syncing so callers that need to send other
        // fire-and-forget setup (SET_OPEN_FILES etc.) before any EDIT can
        // interleave in the correct order.
        ensure_spawned() is
            // Recycle a warm session whose compiler input moved underneath
            // it - a republished tree build, a re-pointed manifest - rather
            // than keep answering on the old compiler until something calls
            // release_session. Throttled to at most one drift check per
            // interval: every query path funnels through here, and a hover
            // burst must not pay a manifest walk per request.
            let now = System.DateTime.utc_now

            if is_running /\ _compiler_fingerprint? /\ now > _next_fingerprint_check then
                _next_fingerprint_check = now.add_seconds(FINGERPRINT_CHECK_INTERVAL_SECONDS)

                if _compiler_fingerprint !~ compute_compiler_fingerprint() then
                    dispose_process()
                fi
            fi

            if !is_running then
                dispose_process()
                start()
            fi
        si

        // Send every new or on-disk-changed source and swallow the
        // diagnostics response the edit provokes.
        sync_sources() is
            let changed = LIST[EDIT_FILE]()

            for path in find_sources() do
                let absolute = Path.combine(_project_directory, path)
                let stamp = File.get_last_write_time_utc(absolute)

                if !_mtimes.contains_key(path) \/ _mtimes[path] !~ stamp then
                    changed.add(EDIT_FILE(path, File.read_all_text(absolute)))
                    _mtimes[path] = stamp
                fi
            od

            if changed.count > 0 then
                write_request(Request.EDIT(changed))
                read_response()
            fi
        si

        // Convenience: spawn + source-sync in one call. Used by every
        // query path that doesn't need to interleave SET_OPEN_FILES between
        // the two.
        ensure_fresh() is
            ensure_spawned()
            sync_sources()
        si

        // Full-project diagnostics: freshen, compile, return the compile's
        // diagnostics response. hints_for is the analyser's editor-open
        // set; hint-level diagnostics (narrowing / narrowing-kill etc.)
        // are gated on it. Always full-set-replace so state doesn't leak
        // across queries - `compile_diagnostics(no args)` reliably
        // suppresses hints even if a previous call opted in.
        compile_diagnostics() -> Response.DIAGNOSTICS =>
            compile_diagnostics(Collections.LIST[string]())

        compile_diagnostics(hints_for: Collections.Iterable[string]) -> Response.DIAGNOSTICS is
            ensure_spawned()

            let open_paths = LIST[string]()

            for p in hints_for do
                if p.length > 0 then
                    open_paths.add(p)
                fi
            od

            // Set open files before any edit-driving compile, so hint
            // gating is in effect for the whole compilation. The wire doc
            // says as much: "sent before the diagnostics-producing
            // requests".
            write_request(Request.SET_OPEN_FILES(open_paths))

            // If the open-files set differs from the previous compile,
            // bust the mtime cache so sync_sources re-EDITs everything.
            // SET_OPEN_FILES on its own doesn't invalidate the analyser's
            // "full compile needed" flag, so a second compile with an
            // unchanged tree just re-collects the previous run's stored
            // diagnostics — hints for the newly-open file don't fire.
            // Forcing an EDIT invalidates the flag; the compile that
            // follows runs compile-expressions again.
            if !open_paths_equal(open_paths, _last_hints_for) then
                _mtimes.clear()
                _last_hints_for = open_paths
            fi

            sync_sources()

            let response = exchange(Request.COMPILE())

            if let diagnostics: Response.DIAGNOSTICS = response then
                maybe_heap_check()
                return diagnostics
            fi

            throw unexpected("diagnostics", response)
        si

        // Cheap single-file diagnostics: catches up any other on-disk-changed
        // files (mtime-gated, so normally a no-op), then re-sends `path`
        // unconditionally as an EDIT so its full-resolution pass runs even
        // when its own mtime hasn't moved since the last sync, and returns
        // that EDIT's diagnostics response directly - never forces the
        // whole-project Request.COMPILE() that compile_diagnostics always
        // pays. Intended for a hook that fires on every edit, where the
        // latency of a full compile isn't acceptable. Diagnostics for other
        // files still come back too (EDIT reports the full known set, same
        // as COMPILE) - callers that only want this file's rows should
        // filter on Response.DIAGNOSTICS.diagnostics by path.
        edit_diagnostics(path: string) -> Response.DIAGNOSTICS is
            ensure_spawned()
            sync_sources()

            let absolute = Path.combine(_project_directory, path)
            let contents = File.read_all_text(absolute)

            let response = exchange(Request.EDIT(LIST([EDIT_FILE(path, contents)])))

            _mtimes[path] = File.get_last_write_time_utc(absolute)

            if let diagnostics: Response.DIAGNOSTICS = response then
                maybe_heap_check()
                return diagnostics
            fi

            throw unexpected("edit_diagnostics", response)
        si

        // Narrowing inlays for one file. The analyser only records inlays
        // for files in the open set during compile-expressions, so drive a
        // compile with `path` open (reusing the diagnostics path's open-set
        // handling and cache-busting) before the retrieval query.
        inlay_hints(path: string) -> Response.INLAY_HINTS is
            compile_diagnostics(Collections.LIST([path]))

            let response = query(Request.INLAY_HINTS(path, null, null, null, null))

            if let inlays: Response.INLAY_HINTS = response then
                return inlays
            fi

            throw unexpected("inlay_hints", response)
        si

        // Send a heap_check ping and read the response. If the analyser's
        // watchdog decides the heap has grown past its recycle threshold,
        // it answers with restart and then exits; drop our handle so the
        // next request spawns a fresh process. Returns true if the
        // analyser is still running afterwards.
        send_heap_check() -> bool is
            if !is_running then
                return false
            fi

            let response = exchange(Request.HEAP_CHECK())

            return is_running
        si

        // Every HEAP_CHECK_EVERY requests, send a heap_check ping so the
        // watchdog can recycle a bloated process proactively.
        maybe_heap_check() is
            if _query_count % cast long(HEAP_CHECK_EVERY) != 0L \/ _query_count == 0L then
                return
            fi

            try
                send_heap_check()
            catch ex: Exception
            yrt
        si

        // Send a request, read the response, and if the analyser signals
        // restart, tear down the process (the watchdog exits after
        // writing restart) and spawn a fresh one, then retry the request
        // once. Anything more than one retry is unusual and surfaces as
        // an exception the caller can convert to a tool result.
        exchange(request: Request) -> Response is
            _query_count = _query_count + 1L

            write_request(request)
            let response mut = read_response()

            if isa Response.RESTART(response) then
                dispose_process()
                ensure_spawned()

                write_request(request)
                response = read_response()

                if isa Response.RESTART(response) then
                    throw Exception("analyser requested restart twice in a row against {_project_directory}")
                fi
            fi

            return response
        si

        hover(path: string, line: int, column: int) -> Response.HOVER is
            let response = query(Request.HOVER(path, line, column))

            if let hover_response: Response.HOVER = response then
                return hover_response
            fi

            throw unexpected("hover", response)
        si

        definition(path: string, line: int, column: int) -> Response.DEFINITION is
            let response = query(Request.DEFINITION(path, line, column))

            if let definition_response: Response.DEFINITION = response then
                return definition_response
            fi

            throw unexpected("definition", response)
        si

        references(path: string, line: int, column: int) -> Response.REFERENCES is
            let response = query(Request.REFERENCES(path, line, column))

            if let references_response: Response.REFERENCES = response then
                return references_response
            fi

            throw unexpected("references", response)
        si

        implementation(path: string, line: int, column: int) -> Response.IMPLEMENTATION is
            let response = query(Request.IMPLEMENTATION(path, line, column))

            if let implementation_response: Response.IMPLEMENTATION = response then
                return implementation_response
            fi

            throw unexpected("implementation", response)
        si

        // Workspace-wide when path is empty.
        symbols(path: string) -> Response.SYMBOLS is
            let response = query(Request.SYMBOLS(path))

            if let symbols_response: Response.SYMBOLS = response then
                return symbols_response
            fi

            throw unexpected("symbols", response)
        si

        // Resolve a type expression by qualified name and return its kind,
        // ancestors and members. Compiler 19.11.0+ answers this natively;
        // the old scratch-file + completion trick is gone.
        describe_type(type_expression: string) -> Response.DESCRIBE_TYPE is
            let response = query(Request.DESCRIBE_TYPE(type_expression))

            if let describe_type_response: Response.DESCRIBE_TYPE = response then
                return describe_type_response
            fi

            throw unexpected("describe_type", response)
        si

        unexpected(wanted: string, response: Response) -> Exception =>
            Exception("expected a {wanted} response but got {response.get_type().name}.\nstderr so far:\n{_stderr_capture}")

        // Freshen, send, and read past any unsolicited diagnostics frame - a
        // query that misses its cache falls through to a full compile, which
        // writes a diagnostics response before the query's own. A restart
        // response means the analyser's watchdog wants to recycle the
        // process: honour it and retry once against a fresh process.
        query(request: Request) -> Response is
            ensure_fresh()
            write_request(request)

            let response mut = read_response()

            if isa Response.DIAGNOSTICS(response) then
                response = read_response()
            fi

            if isa Response.RESTART(response) then
                dispose_process()
                ensure_fresh()
                write_request(request)

                response = read_response()

                if isa Response.DIAGNOSTICS(response) then
                    response = read_response()
                fi
            fi

            return response
        si

        write_request(request: Request) is
            let process = _process

            if !process? then
                throw Exception("analyser process is not running")
            fi

            process.standard_input.write(JsonSerializer.serialize[Request](request, _options))
            process.standard_input.write("\n")
            process.standard_input.flush()
        si

        // Cap on any single response read. A well-behaved analyser answers
        // in milliseconds; even a heavy compile-and-report is well under 60s
        // in practice. Anything longer is either a stuck analyser or a
        // request the analyser doesn't recognise and has silently dropped
        // (older compilers pre-#1634 do this). Turning that into a clean
        // failure - dispose the process, surface the timeout - keeps the
        // pool healthy so subsequent calls don't inherit the wedged state.
        READ_TIMEOUT_MS: int static => 60000

        // Read one line from the analyser's stdout and deserialize it into
        // a Response. Wrapped in a bounded wait so a wedged analyser
        // surfaces as a diagnosable timeout rather than a permanent hang.
        read_response() -> Response is
            let response: Response? mut = null
            let error: Exception? mut = null

            let task = Tasks.TASK.run(
                () is
                    try
                        response = _read_response_unbounded()
                    catch ex: Exception
                        error = ex
                    yrt
                si
            )

            if !task.wait(READ_TIMEOUT_MS) then
                dispose_process()

                throw Exception(
                    "analyser at {_project_directory} did not respond within {READ_TIMEOUT_MS}ms. "
                    "The compiler version pinned by that project may be older than the request "
                    "expects, or the analyser is genuinely stuck. Process disposed; the next "
                    "request will spawn a fresh one.\nstderr so far:\n{_stderr_capture}"
                )
            fi

            if let e: Exception = error then
                throw e
            fi

            if let result: Response = response then
                return result
            fi

            throw Exception(
                "read_response task completed without a response and without an exception "
                "against {_project_directory} - internal invariant violation"
            )
        si

        // One JSON object per line; read characters to the newline and
        // deserialize. Called under the wait budget in read_response.
        _read_response_unbounded() -> Response is
            let process = _process

            if !process? then
                throw Exception("analyser process is not running")
            fi

            let buffer = StringBuilder()

            do
                let c = process.standard_output.read()

                if c < 0 then
                    throw Exception("analyser stdout closed before a response line.\nbuffer so far:\n{buffer}\nstderr so far:\n{_stderr_capture}")
                fi

                if c == 10 then
                    break
                fi

                if c != 13 then
                    buffer.append(cast char(c))
                fi
            od

            let response = JsonSerializer.deserialize[Response](buffer.to_string(), _options)

            if !response? then
                throw Exception("analyser returned null deserialising response: {buffer}")
            fi

            return response
        si

        dispose_process() is
            if let process: Process = _process then
                try
                    process.standard_input.close()
                catch ex: Exception
                yrt

                if !process.wait_for_exit(2000) then
                    try
                        process.kill()
                    catch ex: Exception
                    yrt
                fi
            fi

            _process = null
            _mtimes.clear()

            // Takes the analyser's response file and the build's with it.
            if let directory: string = _temp_directory then
                try
                    Directory.delete(directory, true)
                catch ex: Exception
                yrt

                _temp_directory = null
            fi
        si

        dispose() is
            dispose_process()
        si
    si
si
