use IO.Std

server_version: string => "2.1.0"

// The server version plus, when the default project's pool host has a warm
// analyser, the compiler version it advertised at spawn. Probing never
// spawns a host, so asking the version stays cheap.
describe_version(hosts: Analyser.PROJECT_HOSTS) -> string is
    let info: Analyser.INFO_REPLY? mut = null

    if let default_project: string = hosts.default_project then
        info = Analyser.HOST_CLIENT.info_if_running(default_project)
    fi

    if !info? then
        return "ghul-mcp {server_version} (no analyser session warm for the default project)"
    fi

    if !info.warm then
        return "ghul-mcp {server_version} (no analyser session warm for the default project)"
    fi

    let compiler = info.compiler

    if compiler? then
        return "ghul-mcp {server_version} (ghul.compiler {compiler})"
    fi

    return "ghul-mcp {server_version} (compiler version unknown)"
si

// Where the query log goes when no --query-log / --no-query-log argument
// says otherwise: the XDG state directory, shared by every server instance
// (entries carry the pid). Null - logging off - only when no home
// directory is discoverable.
default_query_log_path() -> string? is
    let state_home = System.Environment.get_environment_variable("XDG_STATE_HOME")

    if state_home? /\ state_home.length > 0 then
        return IO.Path.combine(state_home, "ghul-mcp", "query-log.jsonl")
    fi

    let home = System.Environment.get_environment_variable("HOME")

    if home? /\ home.length > 0 then
        return IO.Path.combine(IO.Path.combine(home, ".local", "state"), "ghul-mcp", "query-log.jsonl")
    fi

    return null
si

entry(arguments: string[]) is
    Std.input_encoding = System.Text.UTF8Encoding(false)
    Std.output_encoding = System.Text.UTF8Encoding(false)

    let default_project: string? mut = null
    let query_log_path: string? mut = default_query_log_path()
    let pool_host_socket: string? mut = null
    let pool_status mut = false
    let edit_hook mut = false
    let pool_idle_timeout mut = Analyser.POOL_HOST.DEFAULT_IDLE_TIMEOUT_SECONDS

    let index mut = 0

    while index < arguments.count do
        let arg = arguments[index]

        if (arg =~ "--project" \/ arg =~ "--default-project") /\ index + 1 < arguments.count then
            default_project = arguments[index + 1]
            index = index + 2
        elif arg =~ "--query-log" /\ index + 1 < arguments.count then
            query_log_path = arguments[index + 1]
            index = index + 2
        elif arg =~ "--no-query-log" then
            query_log_path = null
            index = index + 1
        elif arg =~ "--pool-status" then
            pool_status = true
            index = index + 1
        elif arg =~ "--edit-hook" then
            edit_hook = true
            index = index + 1
        elif arg =~ "--pool-host" /\ index + 1 < arguments.count then
            pool_host_socket = arguments[index + 1]
            index = index + 2
        elif arg =~ "--pool-host-idle-timeout" /\ index + 1 < arguments.count then
            let seconds_string = arguments[index + 1]

            try
                pool_idle_timeout = int.parse(seconds_string)
            catch ex: System.Exception
                Std.error.write_line(
                    "ghul-mcp: ignoring garbled --pool-host-idle-timeout value: {seconds_string}"
                )
            yrt

            index = index + 2
        else
            Std.error.write_line("ghul-mcp: ignoring unrecognised argument {arg}")
            index = index + 1
        fi
    od

    if pool_status then
        Std.out.write(Analyser.POOL_STATUS.render())
        Std.out.flush()

        return
    fi

    if edit_hook then
        Analyser.EDIT_HOOK.run(Std.in, Std.out, pool_idle_timeout)

        return
    fi

    if let socket_path: string = pool_host_socket then
        if let project: string = default_project then
            Analyser.POOL_HOST(project, pool_idle_timeout, server_version, query_log_path).run(socket_path)
        else
            Std.error.write_line("ghul-mcp: --pool-host requires --project")
        fi

        return
    fi

    let reader =
        IO.StreamReader(
            Std.open_standard_input(),
            System.Text.UTF8Encoding(false),
            false,
            65536
        )

    let query_log = MCP.QUERY_LOG(query_log_path)
    let server = MCP.SERVER(reader, Std.out, "ghul-mcp", server_version, query_log)

    // The front end owns no analyser of its own: every tool call routes to
    // the target project's pool host, spawning one on demand (see
    // PROJECT_HOSTS). The idle timeout is propagated to the hosts this
    // process spawns, so a caller that wants short-lived hosts can set it
    // once here.
    let hosts = Analyser.PROJECT_HOSTS(default_project, pool_idle_timeout)

    query_log.log_start("ghul-mcp", server_version, hosts.default_project)

    server.add_tool(
        MCP.TOOL(
            "version",
            "report the ghul-mcp server version, plus the analyser's compiler version when a session is warm for the default project",
            "{{\"type\": \"object\", \"properties\": {{}}}}",
            arguments => describe_version(hosts)
        )
    )

    for tool in Analyser.ANALYSER_TOOLS.tools((name, arguments) => hosts.route(name, arguments)) do
        server.add_tool(tool)
    od

    Analyser.ANALYSER_TOOLS.register_front_end(server, hosts)

    server.run()
si
